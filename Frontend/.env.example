# Copier ce fichier en .env.local (facultatif).
# Origine de l'API vue par le navigateur. Vide (défaut) = même origine : le serveur de
# développement Vite et nginx relaient /api vers le backend.
# VITE_API_URL=https://api.example.com

# Cible du proxy Vite en développement (défaut : http://127.0.0.1:8000)
# VITE_PROXY_TARGET=http://127.0.0.1:8000
