# Copier ce fichier en .env et renseigner les valeurs.

# --- LLM (Groq) ---
GROQ_API_KEY=
# Clés supplémentaires optionnelles, séparées par des virgules
GROQ_API_KEYS=

# --- Recherche web (Tavily) ---
TAVILY_API_KEY=

# --- Tracing (LangSmith, optionnel) ---
LANGSMITH_API_KEY=

# --- Authentification ---
# Secret de signature des JWT. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=


# --- Environnement : dev | prod ---
ENVIRONMENT=dev

# --- Calcul : auto (CUDA si disponible, sinon CPU) | cuda | cpu ---
DEVICE_PREFERENCE=auto

# --- Tracing LangSmith : true pour l'activer (nécessite LANGSMITH_API_KEY) ---
LANGCHAIN_TRACING_V2=false

# --- Base de données ---
# Vide : SQLite local (RAG_DB_PATH). Production : PostgreSQL
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rag
DATABASE_URL=
# Appliquer les migrations Alembic au démarrage de l'API
AUTO_MIGRATE=true

# --- Comptes initiaux créés au démarrage s'ils n'existent pas (optionnel) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- CORS : origines du frontend autorisées (séparées par des virgules) ---
# CORS_ORIGINS=https://app.example.com

# --- Embeddings / reranking : nomic-local (défaut, extra ml) | openai | cohere ---
EMBEDDING_PROVIDER=nomic-local
EMBEDDING_DIM=768
# OPENAI_API_KEY=
# COHERE_API_KEY=
# local (cross-encoder, extra ml) | cohere | none
RERANKER_PROVIDER=local
# Sous ce score de rerank (0-1) la recherche web prend le relais : à calibrer avec l'évaluation
RERANK_MIN_SCORE=0.1

# --- Ingestion des documents ---
MAX_UPLOAD_MB=50
# docling (tableaux conservés, extra ingest) | pypdf (texte brut)
INGEST_PARSER=docling

# --- Sessions : cookies httpOnly (access court + refresh à rotation) ---
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# true derrière HTTPS (production)
COOKIE_SECURE=false

# --- Limites d'usage ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_LOGIN_ACCOUNT_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=20
# Questions par utilisateur et par jour (0 = illimité) ; les administrateurs sont exemptés
DAILY_QUESTION_QUOTA=200
# true derrière un reverse proxy de confiance (nginx, Caddy…) : l'IP du client vient de X-Forwarded-For
TRUST_PROXY_HEADERS=false
